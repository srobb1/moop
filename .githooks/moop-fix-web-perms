#!/bin/sh
#
# Restore world-read on web-served files after git rewrites them.
#
# WHY: git creates files honouring the umask, which on the deployment host yields
# 640 smr:smr. php-fpm runs as `apache` and is in neither the owner nor the group,
# so it cannot read them -> site-wide 500, thrown before MOOP's error handler is
# installed (so logs/error.log stays silent and the real error is only in
# /var/log/php-fpm/www-error.log, which is root-only). This fires on any checkout,
# merge, rebase, cherry-pick, stash pop or reset that writes a served file, and the
# test suites CANNOT catch it: they run as the repo owner, who reads 640 fine.
# See CLAUDE.md §11 "Gotchas that will cost you an afternoon".
#
# INSTALL (per clone — git will not run a tracked hook without this):
#     git config core.hooksPath .githooks
# setup-check.php verifies it, because a clone without it is silently unprotected.
#
# Scope is deliberately `git ls-files` (tracked files only), so this can never widen
# an untracked secret: config/secrets.php and certs/ are gitignored and unreachable
# from here. `o+r` rather than `644` so a file that is legitimately 660 becomes 664
# instead of losing its group-write bit.

repo=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
cd "$repo" || exit 0

# Every kind of file a BROWSER loads, not only .php/.js/.css: the icon fonts, images, the genome
# browser's HTML / JSON / WebAssembly, robots.txt. Until 2026-11-05 this listed only
# .php/.js/.css, so a fresh clone (cuttingclass, the second MOOP on this host) served every icon
# font as 403 -- no icons anywhere -- while setup-check reported all served files readable.
# POSIX sh (this runs as #!/bin/sh -- dash on Debian/Ubuntu, so no bash arrays): the patterns
# are the positional parameters, passed through as "$@".
set -- '*.php' '*.js' '*.css' '*.map' '*.html' '*.json' '*.txt' '*.wasm' \
       '*.woff' '*.woff2' '*.ttf' '*.eot' '*.otf' \
       '*.svg' '*.png' '*.jpg' '*.jpeg' '*.gif' '*.ico' '*.webp'

git ls-files -z -- "$@" \
    ':(exclude)tests/*' ':(exclude)testing/*' 2>/dev/null \
  | xargs -0 -r chmod o+r 2>/dev/null

# ...and the DIRECTORIES holding them. A checkout that adds a new directory creates it
# under the same umask -- 750 smr:smr here -- and php-fpm cannot traverse it, so every
# file inside 404s/500s however readable the file is (2026-10-12: a new
# admin/pages/organism_modals/ came out 750 and would have 500'd every Manage Organisms
# modal; caught before commit).
# `o+x` only -- enter, not list -- and only for directories on the path to a tracked web
# file, every one of which is already served.
git ls-files -- "$@" \
    ':(exclude)tests/*' ':(exclude)testing/*' 2>/dev/null \
  | awk -F/ '{ p = ""; for (i = 1; i < NF; i++) { p = (p == "" ? $i : p "/" $i); print p } }' \
  | sort -u \
  | while IFS= read -r dir; do chmod o+x "$dir" 2>/dev/null; done

exit 0
